# Public HTTPS origin of this deployment, no trailing slash.
PUBLIC_BASE_URL=https://your-meta-mcp.vercel.app

# Meta Marketing API
META_GRAPH_VERSION=vXX.X
META_ACCESS_TOKEN=replace-with-long-lived-system-user-token
# Optional but recommended: used to generate Meta appsecret_proof on API calls.
META_APP_SECRET=
META_AD_ACCOUNT_ID=123456789012345
META_BUSINESS_ID=
META_PAGE_ID=
META_PIXEL_ID=

# Private OAuth gate used when ChatGPT links to this MCP server.
# Use a unique, strong password. Do not reuse your Meta or ChatGPT password.
MCP_OWNER_PASSWORD=replace-with-strong-unique-password
# Generate at least 32 random bytes, e.g. `openssl rand -base64 48`.
MCP_SIGNING_SECRET=replace-with-random-signing-secret
