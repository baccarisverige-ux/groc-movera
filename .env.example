# Movera Host authentication entrypoints
# Point these URLs to backend endpoints that start the corresponding OAuth flow.
# Never commit client secrets here.
VITE_GOOGLE_AUTH_URL=https://api.example.com/auth/google
VITE_APPLE_AUTH_URL=https://api.example.com/auth/apple

# Browser-restricted Google Maps Platform key.
# Copy this file to .env.local for local/StackBlitz development.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Optional Carto basemap key. Leave empty to use free OpenStreetMap raster tiles.
# VITE_CARTO_API_KEY=
