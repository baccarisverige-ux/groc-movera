{
  "name": "movera-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:unit": "npx --yes vitest@3.2.4 run tests/unit",
    "test:e2e": "npx --yes @playwright/test@1.55.0 test tests/e2e",
    "test:e2e:mobile": "npx --yes @playwright/test@1.55.0 test tests/e2e --project=mobile-chromium",
    "test:responsive": "npx --yes @playwright/test@1.55.0 test tests/e2e/responsive-baseline.spec.js --project=desktop-chromium",
    "test:a11y": "npx --yes @playwright/test@1.55.0 test tests/accessibility",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:a11y",
    "quality:architecture": "node scripts/check-architecture.mjs",
    "quality:fast": "npm run lint && npm run quality:architecture && npm run test:unit && npm run build",
    "quality:bundle": "node scripts/check-bundle-budget.mjs",
    "quality:full": "npm run lint && npm run quality:architecture && npm run test:unit && npm run build && npm run quality:bundle && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.76.0",
    "vite": "^8.2.0"
  }
}
